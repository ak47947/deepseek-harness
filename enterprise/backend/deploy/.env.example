# Server-only settings. Do not distribute this file with Desktop.
# Set this build input to the output of git rev-parse HEAD from the source checkout.
DSH_CLIENT_COMMIT_HASH=
DSH_ENTERPRISE_ID=
# Browser sign-in product name; keep this aligned with Desktop's productName.
DSH_ENTERPRISE_PRODUCT_NAME=Atrix Harness
# Public HTTPS origin reachable from employee computers, e.g. https://dsh.example.com.
DSH_ENTERPRISE_ORIGIN=
BETTER_AUTH_SECRET=
# Use a random hexadecimal database password so the Compose connection URL remains valid.
ENTERPRISE_POSTGRES_PASSWORD=
DSH_ENTERPRISE_BOOTSTRAP_EMAIL=
DSH_ENTERPRISE_BOOTSTRAP_PASSWORD=
DSH_ENTERPRISE_MODE=basic
DSH_ENTERPRISE_SESSION_SECONDS=86400

# Optional Desktop sign-in through the company's OIDC provider. Register
# <DSH_ENTERPRISE_ORIGIN>/api/auth/callback/enterprise-oidc at the IdP.
DSH_ENTERPRISE_OIDC_ENABLED=0
# DSH_ENTERPRISE_OIDC_ISSUER=https://idp.example.com
# DSH_ENTERPRISE_OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# DSH_ENTERPRISE_OIDC_CLIENT_ID=
# DSH_ENTERPRISE_OIDC_CLIENT_SECRET=
# DSH_ENTERPRISE_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
DSH_ENTERPRISE_OIDC_DISPLAY_NAME=Company SSO
# Enable only after restricting this application's IdP assignment to approved employees.
DSH_ENTERPRISE_OIDC_AUTO_PROVISION=0
# Set to 0 only with OIDC enabled. Administrator password sign-in remains available.
DSH_ENTERPRISE_PASSWORD_ENABLED=1

# Managed mode only. Keep these empty in basic mode.
# DSH_ENTERPRISE_LITELLM_KEY=
# LITELLM_POSTGRES_PASSWORD=
# LITELLM_SALT_KEY=
# ENTERPRISE_PROVIDER_KEY=
