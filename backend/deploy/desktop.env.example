# Build-machine settings. Distribute the packaged Desktop app to employee computers.
# The origin must match the server's public DSH_ENTERPRISE_ORIGIN.
DSH_DESKTOP_ENTERPRISE_CONFIG='{"appId":"com.example.enterprise","productName":"Example enterprise","origin":"https://dsh.example.com"}'
DSH_DESKTOP_APP_ID=com.example.enterprise
DSH_DESKTOP_ENTERPRISE_UPDATE_URL=https://updates.example.com/releases
DSH_DESKTOP_ENTERPRISE_POLICY_ORIGIN=https://updates.example.com
DSH_DESKTOP_ENTERPRISE_ICON=/absolute/company-icon.png
# Add platform signing settings from apps/desktop/publishing/README.md.
